# GitHub OAuth Configuration
# Create a GitHub OAuth app at https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Registry Authentication Keys
# Generate a self-signed X.509 certificate and private key with:
#   openssl req -x509 -newkey rsa:2048 -nodes \
#     -keyout private_key.pem -out certificate.pem \
#     -days 3650 -subj "/CN=registry-auth"
#
# Then set the values below (replace newlines with \n):
REGISTRY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----"
REGISTRY_CERT="-----BEGIN CERTIFICATE-----\nMIID...\n-----END CERTIFICATE-----"

# ─── Coordinator ──────────────────────────────────────────────────────────────

# Set to any value to enable the game coordinator
ENABLE_COORDINATOR=true

# Which machine backend to use: "fly" (default) or "firecracker"
MACHINE_PROVIDER=fly

# Game host image (public OCI image implementing the gRPC GameHost service)
GAME_HOST_IMAGE=ghcr.io/ch1nq/achtung-game-host:latest

AGENTS_PER_GAME=4
GAME_TICK_RATE_MS=50
GAME_INTERVAL_SECS=10

# ─── Fly.io backend (MACHINE_PROVIDER=fly) ────────────────────────────────────

FLY_TOKEN=your_fly_api_token
FLY_ORG=your_fly_org_slug
# "internal" (from within Fly network) or "public"
FLY_HOST=internal

# ─── Firecracker backend (MACHINE_PROVIDER=firecracker) ───────────────────────
# See scripts/setup-firecracker/README.md for host setup instructions.

# Socket of the DEDICATED firecracker-containerd daemon (serves the CreateVM
# control API). NOT vanilla containerd's /run/containerd/containerd.sock.
CONTAINERD_SOCKET=/run/firecracker-containerd/containerd.sock

# containerd namespace used to isolate game containers
CONTAINERD_NAMESPACE=achtung

# containerd runtime for firecracker microVMs
FIRECRACKER_RUNTIME=aws.firecracker

# Path to the Linux kernel image (vmlinux) used by all microVMs.
# Built + installed from source by scripts/setup-firecracker/install.sh.
FIRECRACKER_KERNEL=/var/lib/firecracker-containerd/runtime/default-vmlinux.bin

# Per-microVM machine size
FIRECRACKER_VCPU_COUNT=1
FIRECRACKER_MEM_SIZE_MIB=512

# Pool of private IPv4 addresses for per-match /24 subnets.
# Must not conflict with the host's physical network.
# A /16 gives up to 255 concurrent matches.
FIRECRACKER_SUBNET_POOL=10.200.0.0/16

# ─── Reaper ───────────────────────────────────────────────────────────────────

REAPER_INTERVAL_SECS=300
REAPER_MAX_AGE_SECS=3600
# Substring used to match this backend's resources for orphan cleanup.
# If unset, defaults per backend: "achtung-match-" (Fly app names) or
# "achtung-" (firecracker container ids "achtung-<id>-slot-N"). Only override
# if you know which backend is active.
# REAPER_PREFIX=achtung-
